# Apify API credentials (Required for live social media scraping)
APIFY_API_TOKEN=apify_api_token_here

# Supabase Database & Auth (Leave empty to use local in-memory fallback for testing)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Pluggable AI Sentiment Analysis Key (Optional: fall back to built-in rule-based NLP analyzer if not provided)
SENTIMENT_API_KEY=

# Default Timezone for Date Range Filtering
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
